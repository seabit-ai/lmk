<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.kitten.lmk</string>
  <key>ProgramArguments</key>
  <array><string>@PREFIX@/.venv/bin/python</string><string>-m</string><string>lmk</string></array>
  <key>WorkingDirectory</key><string>@PREFIX@</string>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONPATH</key><string>@PREFIX@/.engine/mlx-engine:@PREFIX@</string></dict>
  <key>RunAtLoad</key><true/>
  <!-- restart after a crash, not after a clean exit or a config error loop -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOGDIR@/lmk.stdout.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/lmk.stderr.log</string>
</dict>
</plist>
